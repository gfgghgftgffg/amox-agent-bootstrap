{
  "packages": [
    "npm:@indexyz/pi-provider-sub2api",
    "npm:@narumitw/pi-btw",
    "npm:@gfgghgftgffg/pi-web-access-lean",
    "npm:@gfgghgftgffg/rpiv-todo-lean",
    "npm:@gfgghgftgffg/pi-subagents-lean",
    "npm:@monotykamary/pi-retry",
    "npm:pi-sync-suite",
    {
      "source": "npm:pi-autoresearch",
      "skills": []
    },
    "npm:pi-tidy",
    "npm:pi-starline"
  ],
  "defaultProvider": "sub2api",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": ["sub2api/*"],
  "tuiMode": "fullscreen",
  "theme": "catppuccin-mocha",
  "defaultTools": ["+codemode"],
  "tidy": {
    "frameMessages": true,
    "messageBorderColors": {
      "user": "syntaxKeyword"
    }
  },
  "hideThinkingBlock": true
}
